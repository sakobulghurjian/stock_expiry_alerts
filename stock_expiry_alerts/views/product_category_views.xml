<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_view_stock_expiry_alerts" model="ir.ui.view">
        <field name="name">product.category.form.stock.expiry.alerts</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="after">
                <group string="Expiry Alerts" groups="stock.group_stock_manager">
                    <field name="expiry_alert_days" placeholder="e.g. 14, 7, 3, 1"/>
                    <div class="text-muted">
                        Leave empty to use each company's global expiry alert days.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

